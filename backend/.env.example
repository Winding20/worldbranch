# WorldBranch 后端配置示例
# 复制为 .env 并按实际情况填写；.env 不会提交到 Git

# 数据库连接串（二选一）
# 开发期用 SQLite：
WORLDBRANCH_DATABASE_URL=sqlite:///worldbranch.db
# 你服务器上的 MySQL（示例，按实际改）：
# WORLDBRANCH_DATABASE_URL=mysql+pymysql://user:password@192.168.1.10:3306/worldbranch?charset=utf8mb4

# Flask 是否开启调试
WORLDBRANCH_DEBUG=1

# 跨域允许来源（前后端分离时用）
WORLDBRANCH_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173