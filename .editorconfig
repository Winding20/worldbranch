# 编辑器保持一致，免得整文件重排
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{js,mjs,css,json,vue,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# cmd.exe 要求 CRLF，且内容保持 ASCII
[*.bat]
end_of_line = crlf

[*.py]
max_line_length = 100