# --- Node ---
node_modules/
.npm-cache/
dist-ssr/
*.local
.vite/
frontend/dist-smoke/

# 前端构建产物随仓库走：使用者解压/克隆后无需装 Node 即可运行。
# 但 dist/ 是所有前端项目的默认忽略规则，这里显式放行。
dist/
!frontend/dist/
!frontend/dist/**

# --- 项目本地 ---
.db
*.sqlite
*.sqlite3
.tmp/
*.log
dist-package/

# 本地数据库与上传物（不随仓库走）
backend/instance/

# --- 配置 ---
.env
.env.*
!.env.example
backend/.env.mysql.bak

# --- 编辑器 / 系统 ---
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
~$*
*.tmp
# 宣传片产物（体积大，不进仓库）
dist-promo/
# 项目级技能目录（技能装在用户级 ~/.dsh/skills）
.dsh/
# 上传用的打包产物
dist-upload/
